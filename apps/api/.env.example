DATABASE_URL="postgresql://makazi:makazi@localhost:5432/makazi?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
# Base URL of the web app — used to build links inside invitation emails
# (see InvitationEmailService). Not the same as CORS_ORIGIN's purpose.
WEB_APP_URL="http://localhost:3000"

# S3-compatible object storage for property photo uploads (AWS S3, Cloudflare R2, MinIO, Spaces...)
S3_BUCKET="makazi-property-photos"
S3_REGION="auto"
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
S3_ACCESS_KEY_ID="change-me"
S3_SECRET_ACCESS_KEY="change-me"
S3_PUBLIC_URL_BASE="http://localhost:9000/makazi-property-photos"

# Safaricom Daraja (M-Pesa). Leave DARAJA_CONSUMER_KEY empty to use the
# built-in simulator instead of calling Safaricom — see DarajaSimulatorService.
# STK Push always targets the paying property's own PaymentAccount
# (payBillNumber/tillNumber) as BusinessShortCode/PartyB, never a Makazi
# account, per "Makazi must never hold customer funds". Production use needs
# either per-landlord Daraja API Product access or a Safaricom aggregator
# agreement — this app has one shared set of credentials, which is only
# correct once that access exists.
DARAJA_ENV="sandbox"
DARAJA_BASE_URL="https://sandbox.safaricom.co.ke"
DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
DARAJA_PASSKEY=""
DARAJA_CALLBACK_URL="http://localhost:4000/api/payments/mpesa/stk-callback"
# Safaricom C2B (PayBill paid directly, or via USSD) — registered once via
# POST /mpesa/c2b/v1/registerurl in production; here it's just where the
# simulator loops back to.
DARAJA_C2B_CONFIRMATION_URL="http://localhost:4000/api/payments/mpesa/c2b/confirmation"

# External service integrations (SMS/Email/WhatsApp/Maps). Each falls back to
# a logging simulator when unset — see src/integrations/integrations.module.ts.
# Email is shared by both Auth (OTP/reset codes) and Notifications fan-out.
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""
AFRICASTALKING_SENDER_ID=""
AFRICASTALKING_BASE_URL="https://api.sandbox.africastalking.com"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Makazi <notifications@makazi.app>"

# Requires a Meta Business-verified WhatsApp number and an approved message
# template — see WhatsAppCloudService.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Google Maps Geocoding API — turns a property's free-text location into
# lat/lng (see GoogleMapsService). Leave empty to use the deterministic
# simulator (jitters around Nairobi) instead of calling Google.
GOOGLE_MAPS_API_KEY=""

# Clerk — Landlord/Caretaker/Tenant sign-up/sign-in only (Admin/staff stays on
# the JWT flow above). Server-side secret key from your Clerk dashboard's API
# Keys page — see ClerkStrategy/ClerkIdentityStrategy. Never expose this to
# the frontend (that's what NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY in apps/web is for).
CLERK_SECRET_KEY=""
