NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Clerk — Landlord/Caretaker/Tenant sign-up/sign-in only (Admin/staff still
# uses the app's own login at /admin/login). Publishable key from your
# Clerk dashboard's API Keys page — safe to expose in the client bundle.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# @clerk/nextjs's clerkMiddleware() (see src/proxy.ts) needs the secret key
# too, for server-side session verification — same value as apps/api's
# CLERK_SECRET_KEY, never exposed to the client bundle since it's not
# NEXT_PUBLIC_-prefixed.
CLERK_SECRET_KEY=
